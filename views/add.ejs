<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#f4f7fb">
  <title>Add student | Campus</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-shell">
    <%- include('partials/header', { backLink: '/' }) %>

    <main class="main-content form-page">
      <a class="back-link" href="/">
        <span aria-hidden="true">←</span> All students
      </a>
      <section class="form-heading">
        <p class="eyebrow">STUDENT RECORDS</p>
        <h1>Add a student</h1>
        <p class="page-subtitle">Enter the student’s details below to add them to the directory.</p>
      </section>

      <section class="panel form-panel">
        <form action="/students/add" method="POST" class="student-form">
          <div class="form-grid">
            <div class="form-field">
              <label for="student_id">Student ID <span class="required">*</span></label>
              <input id="student_id" type="text" name="student_id" placeholder="e.g. 2026-0004" autocomplete="off" required>
            </div>
            <div class="form-field">
              <label for="course">Course <span class="required">*</span></label>
              <input id="course" type="text" name="course" placeholder="e.g. BS Information Technology" required>
            </div>
            <div class="form-field">
              <label for="first_name">First name <span class="required">*</span></label>
              <input id="first_name" type="text" name="first_name" placeholder="Enter first name" autocomplete="given-name" required>
            </div>
            <div class="form-field">
              <label for="last_name">Last name <span class="required">*</span></label>
              <input id="last_name" type="text" name="last_name" placeholder="Enter last name" autocomplete="family-name" required>
            </div>
            <div class="form-field">
              <label for="year_level">Year level <span class="required">*</span></label>
              <select id="year_level" name="year_level" required>
                <option value="" disabled selected>Select year level</option>
                <option value="1">1st year</option>
                <option value="2">2nd year</option>
                <option value="3">3rd year</option>
                <option value="4">4th year</option>
                <option value="5">5th year</option>
              </select>
            </div>
            <div class="form-field">
              <label for="email">Email address <span class="required">*</span></label>
              <input id="email" type="email" name="email" placeholder="student@example.com" autocomplete="email" required>
            </div>
          </div>

          <p class="form-help"><span class="required">*</span> Required fields</p>
          <div class="form-actions">
            <a class="button button-secondary" href="/">Cancel</a>
            <button class="button button-primary" type="submit">Save student</button>
          </div>
        </form>
      </section>
      <%- include('partials/footer') %>
    </main>
  </div>
</body>
</html>
