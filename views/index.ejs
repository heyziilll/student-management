<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#f4f7fb">
  <title>Students | Campus</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="app-shell">
    <header class="topbar">
      <a class="brand" href="/" aria-label="Campus student directory home">
        <span class="brand-mark" aria-hidden="true">C</span>
        <span>campus<span class="brand-light"> / students</span></span>
      </a>
      <span class="topbar-label">STUDENT DIRECTORY</span>
    </header>

    <main class="main-content">
      <section class="page-heading">
        <div>
          <p class="eyebrow">ACADEMIC RECORDS</p>
          <h1>Student directory</h1>
          <p class="page-subtitle">Manage and find student information in one place.</p>
        </div>
        <a class="button button-primary" href="/students/add">
          <span class="button-icon" aria-hidden="true">+</span>
          Add student
        </a>
      </section>

      <section class="panel" aria-labelledby="list-heading">
        <div class="panel-header">
          <div>
            <h2 id="list-heading">All students</h2>
            <p class="muted">
              <%= students.length %> <%= students.length === 1 ? 'record' : 'records' %>
              <% if (keyword) { %>
                matching “<%= keyword %>”
              <% } %>
            </p>
          </div>
        </div>

        <div class="search-area">
          <form class="search-form" action="/students/search" method="GET" role="search">
            <label class="sr-only" for="student-search">Search students</label>
            <input
              id="student-search"
              type="search"
              name="keyword"
              placeholder="Search name, ID, course..."
              value="<%= typeof keyword === 'string' ? keyword : '' %>"
            >
            <button class="button button-search" type="submit">Search students</button>
            <% if (keyword) { %>
              <a class="button button-clear" href="/">Clear</a>
            <% } %>
          </form>
        </div>

        <% if (students.length) { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th scope="col">Student ID</th>
                  <th scope="col">Student</th>
                  <th scope="col">Course</th>
                  <th scope="col">Year level</th>
                  <th scope="col">Email</th>
                </tr>
              </thead>
              <tbody>
                <% students.forEach((student) => { %>
                  <tr>
                    <td><span class="student-number"><%= student.student_id %></span></td>
                    <td>
                      <div class="student-name">
                        <span class="avatar" aria-hidden="true"><%= (student.first_name || '?').charAt(0).toUpperCase() %></span>
                        <span><%= student.first_name %> <%= student.last_name %></span>
                      </div>
                    </td>
                    <td><%= student.course %></td>
                    <td><span class="year-badge">Year <%= student.year_level %></span></td>
                    <td><a class="email-link" href="mailto:<%= student.email %>"><%= student.email %></a></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">
            <span class="empty-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false">
                <circle cx="9" cy="8" r="3.2"></circle>
                <path d="M3.5 19v-1.3a5.5 5.5 0 0 1 11 0V19zM16 5.2a3.2 3.2 0 0 1 0 6.1M17 14a4.5 4.5 0 0 1 3.5 4.4v.6h-4"></path>
              </svg>
            </span>
            <% if (keyword) { %>
              <h3>No matching students</h3>
              <p>Try another name, student ID, email, or course.</p>
              <a class="button button-secondary" href="/">Show all students</a>
            <% } else { %>
              <h3>No students yet</h3>
              <p>Add the first student to start building your directory.</p>
              <a class="button button-primary" href="/students/add">Add a student</a>
            <% } %>
          </div>
        <% } %>
      </section>
      <footer class="footer-note">Student Management System</footer>
    </main>
  </div>
</body>
</html>
