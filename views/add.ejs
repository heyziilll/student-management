<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Student</title>
</head>
<body>
  <h1>Add Student</h1>
  <form action="/students/add" method="POST">
    <label for="student_id">Student ID:</label><br>
    <input id="student_id" type="text" name="student_id" required><br><br>

    <label for="first_name">First Name:</label><br>
    <input id="first_name" type="text" name="first_name" required><br><br>

    <label for="last_name">Last Name:</label><br>
    <input id="last_name" type="text" name="last_name" required><br><br>

    <label for="course">Course:</label><br>
    <input id="course" type="text" name="course" required><br><br>

    <label for="year_level">Year Level:</label><br>
    <input id="year_level" type="number" name="year_level" min="1" max="5" required><br><br>

    <label for="email">Email:</label><br>
    <input id="email" type="email" name="email" required><br><br>

    <button type="submit">Save Student</button>
  </form>
  <br>
  <a href="/">Back to Student List</a>
</body>
</html>